{
  "description": "An answer to a curate request: the changes to the project's memory items, in the order they apply, and the whole current state.",
  "type": "object",
  "properties": {
    "changes": {"type": "array", "items": {"$ref": "#/$defs/change"}},
    "state": {"$ref": "#/$defs/state"}
  },
  "required": ["changes", "state"],
  "additionalProperties": false,
  "$defs": {
    "item-id": {"type": "string", "pattern": "^i_[0-9a-hjkmnp-tv-z]{12}$"},
    "entry-id": {"type": "string", "pattern": "^e_[0-9a-hjkmnp-tv-z]{12}$"},
    "change": {
      "type": "object",
      "properties": {
        "action": {"type": "string", "enum": ["add", "replace", "withdraw"]},
        "targets": {"description": "No items for add, the items it replaces for replace, and the one item its speaker takes back for withdraw.", "type": "array", "items": {"$ref": "#/$defs/item-id"}},
        "kind": {"type": "string", "enum": ["decision", "preference", "lesson", "reference", "fact"]},
        "quotes": {"description": "Words copied exactly from entries of the request, the deciding quote first.", "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/quote"}},
        "title": {"description": "One line.", "type": "string"},
        "text": {"type": "string"}
      },
      "required": ["action", "targets", "kind", "quotes", "title", "text"],
      "additionalProperties": false
    },
    "quote": {
      "type": "object",
      "properties": {
        "entry": {"$ref": "#/$defs/entry-id"},
        "words": {"type": "string"}
      },
      "required": ["entry", "words"],
      "additionalProperties": false
    },
    "state": {
      "description": "The whole current state, or five empty parts to keep it as it is.",
      "type": "object",
      "properties": {
        "goal": {"type": "array", "items": {"$ref": "#/$defs/line"}},
        "decisions": {"description": "Decisions in force.", "type": "array", "items": {"$ref": "#/$defs/line"}},
        "progress": {"description": "Work in progress.", "type": "array", "items": {"$ref": "#/$defs/line"}},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/line"}},
        "next": {"description": "Next actions.", "type": "array", "items": {"$ref": "#/$defs/line"}}
      },
      "required": ["goal", "decisions", "progress", "blockers", "next"],
      "additionalProperties": false
    },
    "line": {
      "type": "object",
      "properties": {
        "keeps": {"description": "The ID of the request's line that this line keeps or rewords, or empty for a new line.", "type": "string", "pattern": "^(s_[0-9a-hjkmnp-tv-z]{12})?$"},
        "text": {"description": "One sentence.", "type": "string"},
        "cites": {"description": "The items and entries the line rests on.", "type": "array", "items": {"type": "string", "pattern": "^[ei]_[0-9a-hjkmnp-tv-z]{12}$"}},
        "changes": {"description": "The numbers of this answer's changes that the line rests on, counted from 1.", "type": "array", "items": {"type": "integer"}}
      },
      "required": ["keeps", "text", "cites", "changes"],
      "additionalProperties": false
    }
  }
}
