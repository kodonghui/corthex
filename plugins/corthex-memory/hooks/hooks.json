{
  "description": "CORTHEX Memory: at session start, add the working principles, the profile and the current project's settings.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
