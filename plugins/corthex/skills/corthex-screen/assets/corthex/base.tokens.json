{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The CORTHEX layer over IBM Carbon, shared by every mode. Its tokens are named under corthex and point to Carbon tokens wherever Carbon has one.",
  "corthex": {
    "radius": {
      "$type": "dimension",
      "$description": "Rounded corners from Carbon's own radius scale (@carbon/layout), in place of Carbon's square components.",
      "box": {
        "$value": "{border-radius.border-radius-08}",
        "$description": "Boxes, cards, buttons, inputs, tables and stickies."
      },
      "panel": {
        "$value": "{border-radius.border-radius-16}",
        "$description": "Panels, dialogs and the frame of a board."
      },
      "pill": {
        "$value": "{border-radius.border-radius-max}",
        "$description": "Tags, chips and badges."
      }
    },
    "font-family": {
      "$type": "fontFamily",
      "$description": "Carbon's font stacks from @carbon/type 11.71.0: its sans-kr stack as sans, for Korean and Latin text, and mono for code and IDs.",
      "sans": {
        "$value": [
          "IBM Plex Sans KR",
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          ".SFNSText-Regular",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "IBM Plex Mono",
          "Menlo",
          "DejaVu Sans Mono",
          "Bitstream Vera Sans Mono",
          "Courier",
          "monospace"
        ]
      }
    },
    "type": {
      "$type": "typography",
      "$description": "Carbon's productive type styles, with the values of @carbon/type 11.71.0, which ships no token file. Sizes assume a 16 px root.",
      "label-01": {
        "$value": {
          "fontFamily": "{corthex.font-family.sans}",
          "fontSize": {
            "value": 0.75,
            "unit": "rem"
          },
          "fontWeight": 400,
          "letterSpacing": {
            "value": 0.32,
            "unit": "px"
          },
          "lineHeight": 1.33333
        }
      },
      "helper-text-01": {
