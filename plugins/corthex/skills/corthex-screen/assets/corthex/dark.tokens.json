{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "The CORTHEX layer's dark-theme values over Carbon.",
  "corthex": {
    "ai": {
      "$type": "color",
      "text": {
        "$value": "{blue.30}",
        "$description": "Text of the AI label and of an AI proposal's note."
      }
    },
    "sticky": {
      "$type": "color",
      "$description": "Event storming stickies with corthex-discover's legend: step 20 for a legend colour and step 10 for its light variant in the light theme, steps 80 and 70 in the dark theme.",
      "event": {
        "$value": "{orange.80}",
        "$description": "Domain event."
      },
      "command": {
        "$value": "{blue.80}",
        "$description": "Command."
      },
      "actor": {
        "$value": "{yellow.70}",
        "$description": "Actor."
      },
      "aggregate": {
        "$value": "{yellow.80}",
        "$description": "Aggregate."
      },
      "policy": {
        "$value": "{purple.80}",
        "$description": "Policy."
      },
      "read-model": {
        "$value": "{green.70}",
        "$description": "Read model."
      },
      "external-system": {
        "$value": "{magenta.80}",
        "$description": "External system."
      },
      "hotspot": {
        "$value": "{red.80}",
        "$description": "Hotspot."
      },
      "hotspot-answered": {
        "$value": "{green.80}",
        "$description": "Answered hotspot."
      }
    }
  }
}
